#:kivy 2.3.0
#:import os os
#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex

# ═══════════════════════════════════════════════════════════════════════════
# ANYLOAD V1.1 - PREMIUM UI WITH NAVIGATION DRAWER (KivyMD 1.2.0)
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# CUSTOM WIDGETS
# ═══════════════════════════════════════════════════════════════════════════
<ActionCard@MDCard>:
    title: ""
    icon_name: ""
    orientation: "horizontal"
    size_hint_y: None
    height: dp(60)
    size_hint_x: 1
    md_bg_color: get_color_from_hex("#00D2A0")
    radius: [30, 30, 30, 30]
    padding: [dp(20), 0, dp(20), 0]
    spacing: dp(15)
    elevation: 0
    ripple_behavior: True
    
    MDIcon:
        icon: root.icon_name
        theme_text_color: "Custom"
        text_color: 0, 0, 0, 1
        pos_hint: {"center_y": .5}
        size_hint_x: None
        width: self.texture_size[0]
        
    MDLabel:
        text: root.title
        theme_text_color: "Custom"
        text_color: 0, 0, 0, 1
        bold: True
        halign: "left"
        pos_hint: {"center_y": .5}
        
    MDIcon:
        icon: "chevron-right"
        theme_text_color: "Custom"
        text_color: 0, 0, 0, 1
        pos_hint: {"center_y": .5}
        size_hint_x: None
        width: self.texture_size[0]


<TaskCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(100)
    md_bg_color: get_color_from_hex("#1A1A1A")
    radius: [15, 15, 15, 15]
    padding: dp(5)
    spacing: dp(15)
    elevation: 2
    
    # LEFT: Full-height thumbnail with badge
    MDRelativeLayout:
        size_hint_x: 0.35
        
        AsyncImage:
            source: root.thumbnail
            size_hint: 1, 1
            radius: [10, 10, 10, 10]
        
        # Format badge (bottom-right)
        MDCard:
            size_hint: None, None
            size: dp(38), dp(20)
            pos_hint: {"right": 0.95, "bottom": 0.05}
            md_bg_color: 0, 0, 0, 0.8
            radius: [6, 6, 6, 6]
            elevation: 0
            
            MDLabel:
                text: root.badge
                font_name: "Roboto"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "center"
                valign: "center"
                font_size: "10sp"
                bold: True
    
    # RIGHT: 3 seamless layers
    MDBoxLayout:
        orientation: "vertical"
        size_hint_x: 0.65
        spacing: 0
        
        # LAYER 1: Title + Action buttons
        MDBoxLayout:
            size_hint_y: None
            height: dp(32)
            spacing: dp(6)
            
            MDLabel:
                text: root.filename
                font_name: "Roboto"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
                shorten: True
                shorten_from: "right"
                font_size: "15sp"
                valign: "center"
            
            MDIconButton:
                icon: root.play_pause_icon
                theme_icon_color: "Custom"
                icon_color: get_color_from_hex("#00D2A0")
                size_hint: None, None
                size: dp(32), dp(32)
                icon_size: "20sp"
                pos_hint: {"center_y": .5}
                on_release: root.toggle_pause()
                disabled: root.status in ['completed', 'failed', 'cancelled']
            
            MDIconButton:
                icon: "close"
                theme_icon_color: "Custom"
                icon_color: 0.6, 0.6, 0.6, 1
                size_hint: None, None
                size: dp(32), dp(32)
                icon_size: "20sp"
                pos_hint: {"center_y": .5}
                on_release: root.cancel()
        
        # LAYER 2: Progress bar + Percentage
        MDBoxLayout:
            size_hint_y: None
            height: dp(24)
            spacing: dp(8)
            
            MDProgressBar:
                value: root.progress
                color: get_color_from_hex("#00D2A0")
                size_hint_y: None
                height: dp(4)
                pos_hint: {"center_y": .5}
            
            MDLabel:
                text: root.percent_text
                font_name: "Roboto"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: get_color_from_hex("#00D2A0")
                font_size: "12sp"
                bold: True
                size_hint_x: None
                width: dp(45)
                halign: "right"
                valign: "center"
        
        # LAYER 3: Combined status line
        MDBoxLayout:
            size_hint_y: None
            height: dp(44)
            
            MDLabel:
                text: root.bottom_row_text
                font_name: "Roboto"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.55, 0.55, 0.55, 1
                font_size: "11sp"
                halign: "left"
                valign: "center"


<LibraryCard>:
    orientation: "vertical"
    size_hint_y: None
    height: dp(200)
    md_bg_color: get_color_from_hex("#1A1A1A")
    radius: [15, 15, 15, 15]
    elevation: 2
    ripple_behavior: True
    on_release: root.play_media()
    
    # Top: Thumbnail with badge
    MDFloatLayout:
        size_hint_y: 0.75
        
        AsyncImage:
            source: root.thumbnail
            size_hint: 1, 1
        
        # Format badge (MP4/MP3) - top-right corner
        MDCard:
            size_hint: None, None
            size: dp(45), dp(22)
            pos_hint: {"right": 0.98, "top": 0.98}
            md_bg_color: 0, 0, 0, 0.85
            radius: [6, 6, 6, 6]
            elevation: 0
            
            MDLabel:
                text: "MP3" if root.file_type == "audio" else "MP4"
                font_name: "Roboto"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "center"
                valign: "center"
                font_size: "11sp"
                bold: True
    
    # Bottom: Filename + Three-dots menu
    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: 0.25
        padding: [dp(10), dp(5), dp(5), dp(5)]
        spacing: dp(5)
        
        MDLabel:
            text: root.filename
            font_name: "Roboto"
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            shorten: True
            shorten_from: "right"
            valign: "center"
            font_size: "13sp"
        
        MDIconButton:
            icon: "dots-vertical"
            theme_icon_color: "Custom"
            icon_color: get_color_from_hex("#00D2A0")
            size_hint: None, None
            size: dp(36), dp(36)
            icon_size: "20sp"
            pos_hint: {"center_y": .5}
            on_release: root.show_options()


# ═══════════════════════════════════════════════════════════════════════════
# ROOT LAYOUT - PROPER NAVIGATION STRUCTURE
# ═══════════════════════════════════════════════════════════════════════════
MDNavigationLayout:
    
    # ═══════════════════════════════════════════════════════════════════════
    # SCREEN MANAGER (Direct child #1)
    # ═══════════════════════════════════════════════════════════════════════
    ScreenManager:
        id: screen_manager
        
        # Wrapper Screen for all content
        Screen:
            name: "main_wrapper"
            
            MDBoxLayout:
                orientation: "vertical"
                md_bg_color: 0.05, 0.05, 0.05, 1
                
                # TOP BAR
                MDBoxLayout:
                    size_hint_y: None
                    height: dp(65)
                    md_bg_color: 0, 0, 0, 1
                    padding: [dp(5), dp(10)]
                    
                    MDIconButton:
                        icon: "menu"
                        theme_icon_color: "Custom"
                        icon_color: 1, 1, 1, 1
                        pos_hint: {"center_y": .5}
                        on_release: app.open_drawer()
                    
                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: 0
                        pos_hint: {"center_y": .5}
                        
                        MDLabel:
                            text: "ANYLOAD"
                            font_name: "Roboto"
                            font_style: "H6"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#00D2A0")
                            size_hint_y: None
                            height: dp(30)
                            halign: "left"
                        
                        MDLabel:
                            text: app.dot_text if app.is_active_download else ""
                            font_name: "Roboto"
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#00D2A0")
                            font_size: "14sp"
                            size_hint_y: None
                            height: dp(15)
                            halign: "left"
                    
                    Widget:
                    
                    MDIconButton:
                        icon: "cog"
                        theme_icon_color: "Custom"
                        icon_color: 1, 1, 1, 1
                        pos_hint: {"center_y": .5}
                        on_release: app.switch_to_configs()
                
                # CONTENT SCREEN MANAGER
                ScreenManager:
                    id: content_manager
                    
                    # SPLASH SCREEN
                    Screen:
                        name: "loading"
                        
                        MDBoxLayout:
                            orientation: "vertical"
                            padding: dp(50)
                            spacing: dp(20)
                            
                            Widget:
                                size_hint_y: 0.3
                            
                            Image:
                                source: "assets/logo.png" if os.path.exists("assets/logo.png") else ""
                                size_hint: None, None
                                size: dp(150), dp(150)
                                pos_hint: {"center_x": .5}
                            
                            MDLabel:
                                text: "..."
                                font_name: "Roboto"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#00D2A0")
                                font_size: "24sp"
                                halign: "center"
                                size_hint_y: None
                                height: dp(30)
                            
                            Widget:
                                size_hint_y: 0.3
                    
                    # HOME SCREEN
                    Screen:
                        name: "home"
                        
                        MDScrollView:
                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(20)
                                spacing: dp(20)
                                adaptive_height: True
                                
                                Image:
                                    source: "assets/logo.png" if os.path.exists("assets/logo.png") else ""
                                    size_hint: None, None
                                    size: dp(100), dp(100)
                                    pos_hint: {"center_x": .5}
                                    opacity: 1 if os.path.exists("assets/logo.png") else 0
                                
                                MDCard:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: dp(60)
                                    radius: [30, 30, 30, 30]
                                    md_bg_color: get_color_from_hex("#1A1A1A")
                                    padding: [dp(20), 0, dp(10), 0]
                                    spacing: dp(10)
                                    elevation: 0
                                    
                                    TextInput:
                                        id: url_input
                                        hint_text: "Paste video link here..."
                                        background_color: 0, 0, 0, 0
                                        foreground_color: 1, 1, 1, 1
                                        cursor_color: get_color_from_hex("#00D2A0")
                                        hint_text_color: 0.5, 0.5, 0.5, 1
                                        multiline: False
                                        font_size: "15sp"
                                        padding: [0, dp(18), 0, 0]
                                        on_text: app.validate_url()
                                    
                                    MDIconButton:
                                        icon: "clipboard-outline"
                                        theme_icon_color: "Custom"
                                        icon_color: get_color_from_hex("#00D2A0")
                                        pos_hint: {"center_y": .5}
                                        on_release: app.paste_url()
                                
                                MDLabel:
                                    id: url_error
                                    text: ""
                                    theme_text_color: "Error"
                                    font_style: "Caption"
                                    size_hint_y: None
                                    height: dp(20)
                                    opacity: 0
                                
                                ActionCard:
                                    title: "Auto Best Quality"
                                    icon_name: "flash"
                                    on_release: app.start_download('auto')
                                
                                ActionCard:
                                    title: "Audio Only (MP3)"
                                    icon_name: "music-note"
                                    on_release: app.start_download('audio')
                                
                                ActionCard:
                                    title: "Playlist Download"
                                    icon_name: "playlist-play"
                                    on_release: app.start_download('playlist')
                    
                    # TASKS SCREEN
                    Screen:
                        name: "tasks"
                        
                        MDBoxLayout:
                            orientation: "vertical"
                            padding: dp(15)
                            spacing: dp(15)
                            
                            MDLabel:
                                text: "Active Downloads"
                                font_name: "Roboto"
                                font_style: "H6"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                halign: "center"
                                size_hint_y: None
                                height: dp(30)
                            
                            MDScrollView:
                                MDBoxLayout:
                                    id: task_container
                                    orientation: "vertical"
                                    adaptive_height: True
                                    spacing: dp(15)
                                    
                                    MDLabel:
                                        text: "No active downloads"
                                        font_name: "Roboto"
                                        font_style: "Subtitle1"
                                        theme_text_color: "Hint"
                                        halign: "center"
                                        size_hint_y: None
                                        height: dp(50)
                    
                    # LIBRARY SCREEN
                    Screen:
                        name: "library"
                        
                        MDBoxLayout:
                            orientation: "vertical"
                            
                            MDBoxLayout:
                                size_hint_y: None
                                height: dp(50)
                                md_bg_color: 0.08, 0.08, 0.08, 1
                                
                                MDFlatButton:
                                    text: "VIDEOS"
                                    font_name: "Roboto"
                                    theme_text_color: "Custom"
                                    text_color: get_color_from_hex("#00D2A0") if lib_sm.current == "videos" else (0.5, 0.5, 0.5, 1)
                                    size_hint_x: 1
                                    on_release: lib_sm.current = "videos"
                                
                                MDFlatButton:
                                    text: "AUDIO"
                                    font_name: "Roboto"
                                    theme_text_color: "Custom"
                                    text_color: get_color_from_hex("#00D2A0") if lib_sm.current == "audio" else (0.5, 0.5, 0.5, 1)
                                    size_hint_x: 1
                                    on_release: lib_sm.current = "audio"
                                
                                MDFlatButton:
                                    text: "PLAYLISTS"
                                    font_name: "Roboto"
                                    theme_text_color: "Custom"
                                    text_color: get_color_from_hex("#00D2A0") if lib_sm.current == "playlists" else (0.5, 0.5, 0.5, 1)
                                    size_hint_x: 1
                                    on_release: lib_sm.current = "playlists"
                            
                            ScreenManager:
                                id: lib_sm
                                
                                Screen:
                                    name: "videos"
                                    
                                    RecycleView:
                                        id: video_rv
                                        viewclass: "LibraryCard"
                                        
                                        RecycleGridLayout:
                                            cols: 2
                                            default_size: None, dp(200)
                                            default_size_hint: 1, None
                                            size_hint_y: None
                                            height: self.minimum_height
                                            padding: dp(15)
                                            spacing: dp(15)
                                
                                Screen:
                                    name: "audio"
                                    
                                    RecycleView:
                                        id: audio_rv
                                        viewclass: "LibraryCard"
                                        
                                        RecycleGridLayout:
                                            cols: 2
                                            default_size: None, dp(200)
                                            default_size_hint: 1, None
                                            size_hint_y: None
                                            height: self.minimum_height
                                            padding: dp(15)
                                            spacing: dp(15)
                                
                                Screen:
                                    name: "playlists"
                                    
                                    MDLabel:
                                        text: "Playlists coming soon..."
                                        font_name: "Roboto"
                                        font_style: "Subtitle1"
                                        theme_text_color: "Hint"
                                        halign: "center"
                    
                    # CONFIGS SCREEN
                    Screen:
                        name: "configs"
                        
                        MDScrollView:
                            MDBoxLayout:
                                orientation: "vertical"
                                padding: dp(20)
                                spacing: dp(20)
                                adaptive_height: True
                                
                                MDIconButton:
                                    icon: "arrow-left"
                                    theme_icon_color: "Custom"
                                    icon_color: get_color_from_hex("#00D2A0")
                                    pos_hint: {"left": 1}
                                    on_release: content_manager.current = "home"
                                
                                MDBoxLayout:
                                    orientation: "vertical"
                                    size_hint_y: None
                                    height: dp(150)
                                    spacing: dp(10)
                                    
                                    Image:
                                        source: "assets/logo.png" if os.path.exists("assets/logo.png") else ""
                                        size_hint: None, None
                                        size: dp(80), dp(80)
                                        pos_hint: {"center_x": .5}
                                    
                                    MDLabel:
                                        text: "AnyLoad"
                                        font_name: "Roboto"
                                        font_style: "H5"
                                        bold: True
                                        theme_text_color: "Custom"
                                        text_color: 1, 1, 1, 1
                                        halign: "center"
                                        size_hint_y: None
                                        height: dp(30)
                                    
                                    MDLabel:
                                        text: "Download Anything. Anytime."
                                        font_name: "Roboto"
                                        font_style: "Subtitle2"
                                        theme_text_color: "Custom"
                                        text_color: get_color_from_hex("#00D2A0")
                                        halign: "center"
                                        size_hint_y: None
                                        height: dp(20)
                                
                                MDCard:
                                    orientation: "vertical"
                                    size_hint_y: None
                                    height: dp(200)
                                    radius: [15, 15, 15, 15]
                                    md_bg_color: 0.1, 0.1, 0.1, 1
                                    padding: dp(20)
                                    spacing: dp(15)
                                    
                                    MDLabel:
                                        text: "Settings"
                                        font_name: "Roboto"
                                        font_style: "H6"
                                        theme_text_color: "Custom"
                                        text_color: 1, 1, 1, 1
                                        size_hint_y: None
                                        height: dp(30)
                                    
                                    MDBoxLayout:
                                        orientation: "horizontal"
                                        size_hint_y: None
                                        height: dp(40)
                                        
                                        MDLabel:
                                            text: "Max Concurrent Downloads"
                                            font_name: "Roboto"
                                            font_style: "Subtitle2"
                                            theme_text_color: "Custom"
                                            text_color: 1, 1, 1, 1
                                        
                                        MDLabel:
                                            text: str(int(concurrent_slider.value))
                                            font_name: "Roboto"
                                            font_style: "Subtitle2"
                                            theme_text_color: "Custom"
                                            text_color: get_color_from_hex("#00D2A0")
                                            size_hint_x: None
                                            width: dp(30)
                                            halign: "right"
                                    
                                    MDSlider:
                                        id: concurrent_slider
                                        min: 1
                                        max: 5
                                        value: 3
                                        step: 1
                                        color: get_color_from_hex("#00D2A0")
                                        on_value: app.max_concurrent = self.value
                                
                                MDLabel:
                                    text: "Version 1.1.0"
                                    font_name: "Roboto"
                                    font_style: "Caption"
                                    theme_text_color: "Hint"
                                    halign: "center"
                                    size_hint_y: None
                                    height: dp(30)
                
                # BOTTOM NAV
                MDBoxLayout:
                    size_hint_y: None
                    height: dp(65)
                    md_bg_color: 0, 0, 0, 1
                    padding: [dp(5), dp(5)]
                    
                    MDGridLayout:
                        cols: 3
                        spacing: 0
                        
                        MDRelativeLayout:
                            MDIconButton:
                                icon: "home" if content_manager.current == "home" else "home-outline"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#00D2A0") if content_manager.current == "home" else (0.6, 0.6, 0.6, 1)
                                pos_hint: {"center_x": .5, "center_y": .6}
                                on_release: content_manager.current = "home"
                            
                            MDLabel:
                                text: "Home"
                                font_name: "Roboto"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#00D2A0") if content_manager.current == "home" else (0.6, 0.6, 0.6, 1)
                                halign: "center"
                                pos_hint: {"center_x": .5, "center_y": .2}
                                font_size: "10sp"
                        
                        MDRelativeLayout:
                            MDIconButton:
                                icon: "download" if content_manager.current == "tasks" else "download-outline"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#00D2A0") if content_manager.current == "tasks" else (0.6, 0.6, 0.6, 1)
                                pos_hint: {"center_x": .5, "center_y": .6}
                                on_release: content_manager.current = "tasks"
                            
                            MDLabel:
                                text: "Tasks"
                                font_name: "Roboto"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#00D2A0") if content_manager.current == "tasks" else (0.6, 0.6, 0.6, 1)
                                halign: "center"
                                pos_hint: {"center_x": .5, "center_y": .2}
                                font_size: "10sp"
                        
                        MDRelativeLayout:
                            MDIconButton:
                                icon: "folder-play" if content_manager.current == "library" else "folder-play-outline"
                                theme_icon_color: "Custom"
                                icon_color: get_color_from_hex("#00D2A0") if content_manager.current == "library" else (0.6, 0.6, 0.6, 1)
                                pos_hint: {"center_x": .5, "center_y": .6}
                                on_release: content_manager.current = "library"
                            
                            MDLabel:
                                text: "Library"
                                font_name: "Roboto"
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: get_color_from_hex("#00D2A0") if content_manager.current == "library" else (0.6, 0.6, 0.6, 1)
                                halign: "center"
                                pos_hint: {"center_x": .5, "center_y": .2}
                                font_size: "10sp"
    
    # ═══════════════════════════════════════════════════════════════════════
    # NAVIGATION DRAWER (Direct child #2)
    # ═══════════════════════════════════════════════════════════════════════
    MDNavigationDrawer:
        id: nav_drawer
        anchor: "left"
        
        MDBoxLayout:
            orientation: "vertical"
            spacing: 0
            
            # TOP: Close button
            MDBoxLayout:
                size_hint_y: None
                height: dp(60)
                padding: [dp(15), dp(10)]
                md_bg_color: 0.05, 0.05, 0.05, 1
                
                MDIconButton:
                    icon: "close"
                    theme_icon_color: "Custom"
                    icon_color: 1, 1, 1, 1
                    pos_hint: {"center_y": .5}
                    on_release: app.close_drawer()
                
                Widget:
            
            # HEADER: Logo and Title
            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(140)
                padding: dp(20)
                md_bg_color: 0.08, 0.08, 0.08, 1
                spacing: dp(10)
                
                Image:
                    source: "assets/logo.png" if os.path.exists("assets/logo.png") else ""
                    size_hint: None, None
                    size: dp(60), dp(60)
                    pos_hint: {"center_x": .5}
                
                MDLabel:
                    text: "AnyLoad"
                    font_name: "Roboto"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: get_color_from_hex("#00D2A0")
                    halign: "center"
                    size_hint_y: None
                    height: dp(30)
            
            # MENU ITEMS
            MDList:
                OneLineIconListItem:
                    text: "Download History"
                    on_release: app.show_download_history()
                    
                    IconLeftWidget:
                        icon: "history"
                        theme_icon_color: "Custom"
                        icon_color: get_color_from_hex("#00D2A0")
                
                OneLineIconListItem:
                    text: "Supported Sites"
                    on_release: app.show_supported_sites()
                    
                    IconLeftWidget:
                        icon: "web"
                        theme_icon_color: "Custom"
                        icon_color: get_color_from_hex("#00D2A0")
                
                OneLineIconListItem:
                    text: "Share AnyLoad"
                    on_release: app.share_app()
                    
                    IconLeftWidget:
                        icon: "share-variant"
                        theme_icon_color: "Custom"
                        icon_color: get_color_from_hex("#00D2A0")
                
                OneLineIconListItem:
                    text: "Report an Issue"
                    on_release: app.show_report_issue()
                    
                    IconLeftWidget:
                        icon: "bug-outline"
                        theme_icon_color: "Custom"
                        icon_color: get_color_from_hex("#00D2A0")
                
                OneLineIconListItem:
                    text: "About AnyLoad"
                    on_release: app.show_about_dialog()
                    
                    IconLeftWidget:
                        icon: "information-outline"
                        theme_icon_color: "Custom"
                        icon_color: get_color_from_hex("#00D2A0")
